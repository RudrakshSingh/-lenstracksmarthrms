# HR Service Environment Configuration

# Node Environment
NODE_ENV=production

# Service Configuration
PORT=3002
SERVICE_NAME=hr-service

# Azure Cosmos DB (MongoDB API) Connection
# Primary Connection String:
MONGO_URI=mongodb://db_user:PASSWORD@your-docdb-cluster.cluster-xxxx.ap-south-1.docdb.amazonaws.com:27017/etelios_hr_service?tls=true&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false

# Secondary Connection String (for failover):
# DOCDB_TLS_CA_FILE=/etc/ssl/certs/ca-cert.pem

# JWT Configuration
JWT_SECRET=your-64-character-jwt-secret-key-here-make-it-very-secure
JWT_REFRESH_SECRET=your-64-character-jwt-refresh-secret-key-here-make-it-very-secure
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:3000
AZURE_FRONTEND_URL=https://your-frontend.azurewebsites.net

# Storage
STORAGE_PROVIDER=azure
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=yourstorage;AccountKey=yourkey;EndpointSuffix=core.windows.net

# Logging
LOG_LEVEL=info

# Test Mode (set to false in production)
TEST_MODE=false
ENABLE_ROLE_SEEDING=false

# If true, reject requests when X-Tenant-Id does not match JWT tenant (default: JWT wins if header is wrong)
# STRICT_TENANT_HEADER=false
