# Auth Service Environment Configuration

# Node Environment
NODE_ENV=production

# Service Configuration
PORT=3001
SERVICE_NAME=auth-service

# Azure Cosmos DB (MongoDB API) Connection
# Primary Connection String:
MONGO_URI=mongodb://db_user:PASSWORD@your-docdb-cluster.cluster-xxxx.ap-south-1.docdb.amazonaws.com:27017/etelios_auth_service?tls=true&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false

# Secondary Connection String (for failover):
# DOCDB_TLS_CA_FILE=/etc/ssl/certs/ca-cert.pem

# JWT Configuration
JWT_SECRET=your-64-character-jwt-secret-key-here-make-it-very-secure
JWT_REFRESH_SECRET=your-64-character-jwt-refresh-secret-key-here-make-it-very-secure
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# Test Mode (set to false in production)
TEST_MODE=false

# Permission matrix static UI: in production keep off unless explicitly enabled
# SERVE_PERMISSION_MATRIX_UI=1
# DISABLE_PERMISSION_MATRIX_UI=1
# PERMISSION_WRITE_RATE_MAX=120
# PERMISSION_USER_CACHE_TTL_SEC=900
# PERMISSION_ROLE_CACHE_TTL_SEC=600
