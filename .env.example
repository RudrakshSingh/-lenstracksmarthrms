# ===============================
# General
# ===============================
NODE_ENV=production
PORT=3000
APP_NAME=Lenstrack Smart HRMS
LOG_LEVEL=info   # Options: info, debug, warn, error

# ===============================
# MongoDB
# ===============================
MONGO_USER=hrms_admin
MONGO_PASS=strongpassword123
MONGO_DB=hrms
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_URI=mongodb://${MONGO_USER}:${MONGO_PASS}@${MONGO_HOST}:${MONGO_PORT}/${MONGO_DB}?authSource=admin

# ===============================
# Redis
# ===============================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password   # Optional if not set
REDIS_DB=0

# ===============================
# JWT Authentication
# ===============================
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# ===============================
# Cloudinary (for selfies, assets, documents)
# ===============================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_SECURE=true

# ===============================
# Attendance / Geofencing
# ===============================
DEFAULT_GEOFENCE_RADIUS_M=100     # Default radius in meters for stores
MAX_SELFIE_SIZE_MB=5             # Max size of uploaded selfie
PHOTO_STORAGE_PATH=uploads/attendance_photos

# ===============================
# Email / Notifications (Optional)
# ===============================
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=your_email_user
EMAIL_PASS=your_email_password
EMAIL_FROM=hrms@lenstrack.com

# ===============================
# Security
# ===============================
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000       # 1 minute window for rate limiting
RATE_LIMIT_MAX=10                # Max 10 requests per window per IP

# Azure Blob Storage - SAS Token Configuration
# Use the provided SAS token (update with your storage account name and container)
# Format: https://[accountname].blob.core.windows.net/[containername]?[sas-token]
# 
# IMPORTANT: The provided token has only 'r' (read) permission.
# For uploads to work, generate a new SAS token with 'rwc' (read, write, create) permissions.
#
# Option 1: Full SAS URL (Recommended)
AZURE_STORAGE_SAS_URL=https://YOUR_STORAGE_ACCOUNT.blob.core.windows.net/hrms-images?sp=r&st=2026-01-02T05:06:06Z&se=2027-01-05T13:21:06Z&spr=https&sv=2024-11-04&sr=c&sig=oPMg4GIpmJHdZHGGmqZ1TWtX2m6LpWQKQJwlWiRLB6c%3D

# Option 2: Separate SAS Token and Account (Alternative)
# AZURE_STORAGE_SAS_TOKEN=sp=r&st=2026-01-02T05:06:06Z&se=2027-01-05T13:21:06Z&spr=https&sv=2024-11-04&sr=c&sig=oPMg4GIpmJHdZHGGmqZ1TWtX2m6LpWQKQJwlWiRLB6c%3D
# AZURE_STORAGE_ACCOUNT_NAME=YOUR_STORAGE_ACCOUNT
# AZURE_STORAGE_CONTAINER_NAME=hrms-images
