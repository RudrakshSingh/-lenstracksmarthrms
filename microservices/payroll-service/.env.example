# payroll-service Environment Configuration
NODE_ENV=development
PORT=3004
SERVICE_NAME=payroll-service

# Database
MONGO_URI=mongodb://localhost:27017/etelios_payroll_service

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-jwt-secret-key
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key

# External Services
AUTH_SERVICE_URL=http://auth-service:3001
NOTIFICATION_SERVICE_URL=http://notification-service:3015
FINANCIAL_SERVICE_URL=http://financial-service
ATTENDANCE_SERVICE_URL=http://attendance-service:3003

# HR — required for statutory export enrichment (UAN, PAN, bank) via POST /api/hr/payroll/statutory-lookup
# Use reachable URL per environment (Docker service name, localhost, or internal LB).
HR_SERVICE_URL=http://hr-service:3002
# Payroll forwards the incoming request's Authorization + X-Tenant-Id + X-Company-Id to HR (JWT tenant/company used if headers absent).

# Payroll attendance preview (GET /api/payroll-workflow/attendance-preview)
# PAYROLL_ATTENDANCE_PREVIEW_MAX_ROWS=50000
# PAYROLL_ATTENDANCE_PREVIEW_PAGE_SIZE=500

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@etelios.com

# SMS
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# File Storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Security
ENCRYPTION_MASTER_KEY=your-32-character-encryption-key
CORS_ORIGIN=http://localhost:3000
# Production: set true so mutating routes require x-tenant-id + x-company-id aligned with JWT
STRICT_TENANT_CONTEXT=false

# CSRF: enforce at BFF/API gateway (same-site cookies, CSRF token, origin allowlist). Not applied inside payroll-service.
# After auth Role/permission updates, users should re-login (or wait for permission cache TTL) to pick up new payroll_* codes.