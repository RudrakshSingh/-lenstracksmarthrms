# Production SSL/TLS Configuration
# Copy this file to your production environment and update paths

# ============================================
# SSL/TLS Configuration - PRODUCTION
# ============================================

# Enable SSL/HTTPS (REQUIRED for production)
ENABLE_SSL=true
ENABLE_HTTPS=true

# SSL Certificate Paths - PRODUCTION
# IMPORTANT: These paths should point to your production SSL certificates
# Certificate file location (Sectigo CA-signed certificate for *.etelios.com)
SSL_CERT_PATH=/etc/ssl/certs/etelios-cert.pem
SSL_CERTIFICATE_PATH=/etc/ssl/certs/etelios-cert.pem

# Private Key Path - CRITICAL SECURITY
# IMPORTANT: Private key should be stored securely and NEVER committed to Git
# The private key file should be placed in a secure location with restricted permissions (600)
SSL_KEY_PATH=/etc/ssl/private/etelios-key.pem
SSL_CERTIFICATE_KEY_PATH=/etc/ssl/private/etelios-key.pem

# SSL/TLS Security Settings - PRODUCTION
SSL_MIN_VERSION=TLSv1.2
SSL_MAX_VERSION=TLSv1.3
SSL_REJECT_UNAUTHORIZED=true
# NEVER set SSL_REJECT_UNAUTHORIZED=false in production

# SSL Cipher Suites (Production-grade secure ciphers)
SSL_CIPHERS=ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-SHA256:ECDHE-RSA-AES256-SHA384:!aNULL:!eNULL:!EXPORT:!DES:!RC4:!MD5:!PSK:!SRP:!CAMELLIA

# ============================================
# Certificate Information
# ============================================
# Certificate: Sectigo Public Server Authentication CA DV R36
# Domain: *.etelios.com, etelios.com
# Valid Until: 2027-01-02 23:59:59
# Issuer: Sectigo Limited
# ============================================

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Place your SSL certificate at: /etc/ssl/certs/etelios-cert.pem
# 2. Place your private key at: /etc/ssl/private/etelios-key.pem
# 3. Set proper permissions:
#    chmod 644 /etc/ssl/certs/etelios-cert.pem
#    chmod 600 /etc/ssl/private/etelios-key.pem
# 4. Update the paths above if using different locations
# 5. Set ENABLE_SSL=true in your production environment
# ============================================

