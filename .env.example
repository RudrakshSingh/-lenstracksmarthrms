# ===============================
# General
# ===============================
NODE_ENV=production
PORT=3000
APP_NAME=Lenstrack Smart HRMS
LOG_LEVEL=info   # Options: info, debug, warn, error

# ===============================
# MongoDB Connection (Azure Cosmos DB)
# ===============================
# Single connection string - database name is specified per service
# Format: mongodb://[username]:[password]@[host]:10255/?ssl=true&replicaSet=globaldb&retryWrites=false&maxIdleTimeMS=120000&appName=@[appname]@
MONGO_URI=mongodb://etelios-mongo-db:PASSWORD@etelios-mongo-db.mongo.cosmos.azure.com:10255/?ssl=true&replicaSet=globaldb&retryWrites=false&maxIdleTimeMS=120000&appName=@etelios-mongo-db@

# Service-Specific Database Names (used with MONGO_URI above)
# Each service connects to MONGO_URI and uses its specific DB_NAME
AUTH_SERVICE_DB_NAME=auth-db
HR_SERVICE_DB_NAME=hr-db
ATTENDANCE_SERVICE_DB_NAME=attendance-db
PAYROLL_SERVICE_DB_NAME=payroll-db
NOTIFICATION_SERVICE_DB_NAME=notification-db
ANALYTICS_SERVICE_DB_NAME=analytics-db
DOCUMENT_SERVICE_DB_NAME=document-db
CRM_SERVICE_DB_NAME=crm-db
CPP_SERVICE_DB_NAME=cpp-db
PRESCRIPTION_SERVICE_DB_NAME=prescription-db
PURCHASE_SERVICE_DB_NAME=purchase-db
SALES_SERVICE_DB_NAME=sales-db
INVENTORY_SERVICE_DB_NAME=inventory-db
FINANCIAL_SERVICE_DB_NAME=financial-db
SERVICE_MANAGEMENT_DB_NAME=service-management-db
REALTIME_SERVICE_DB_NAME=realtime-db
TENANT_REGISTRY_SERVICE_DB_NAME=tenant-registry-db
MONITORING_SERVICE_DB_NAME=monitoring-db

# Default DB Name (fallback)
DB_NAME=auth-db

# ===============================
# Local MongoDB (for development only)
# ===============================
# MONGO_USER=hrms_admin
# MONGO_PASS=strongpassword123
# MONGO_HOST=localhost
# MONGO_PORT=27017
# MONGO_URI=mongodb://${MONGO_USER}:${MONGO_PASS}@${MONGO_HOST}:${MONGO_PORT}/?authSource=admin

# ===============================
# Redis
# ===============================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_strong_redis_password_change_in_production
REDIS_DB=0
REDIS_URL=redis://:your_strong_redis_password_change_in_production@redis:6379/0

# ===============================
# JWT Authentication Secrets
# ===============================
# IMPORTANT: Generate strong secrets for production!
# Use: openssl rand -base64 64
JWT_SECRET=change_this_to_a_strong_64_character_secret_in_production_use_openssl_rand_base64_64
JWT_EXPIRES_IN=1h

# JWT Refresh Token (MUST be different from JWT_SECRET)
JWT_REFRESH_SECRET=change_this_to_a_different_strong_64_character_secret_in_production_must_be_unique
JWT_REFRESH_EXPIRES_IN=7d

# Additional JWT Configuration
JWT_ALGORITHM=HS256
JWT_ISSUER=hrms-backend
JWT_AUDIENCE=hrms-frontend

# ===============================
# Cloudinary (for images, documents)
# ===============================
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
CLOUDINARY_SECURE=true

# ===============================
# Attendance / Geofencing
# ===============================
DEFAULT_GEOFENCE_RADIUS_M=100
MAX_SELFIE_SIZE_MB=5
PHOTO_STORAGE_PATH=uploads/attendance_photos

# ===============================
# Email Configuration
# ===============================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_specific_password_here
EMAIL_FROM=noreply@etelios.com
EMAIL_FROM_NAME=Etelios HRMS

# Alternative - Mailtrap for testing
# EMAIL_HOST=smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_USER=your_mailtrap_username
# EMAIL_PASS=your_mailtrap_password

# ===============================
# SMS Configuration (Optional)
# ===============================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ===============================
# Security Settings
# ===============================
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# CORS Settings
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# ===============================
# Azure Blob Storage
# ===============================
# For document uploads, images, etc.
AZURE_STORAGE_SAS_URL=https://your-storage-account.blob.core.windows.net/container-name?sp=rwc&st=2026-01-01T00:00:00Z&se=2027-01-01T00:00:00Z&spr=https&sv=2024-11-04&sr=c&sig=YOUR_SIGNATURE_HERE
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name
AZURE_STORAGE_CONTAINER_NAME=hrms-documents

# ===============================
# Azure Key Vault (Optional)
# ===============================
AZURE_KEY_VAULT_NAME=your-keyvault-name
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# ===============================
# Frontend/Backend URLs
# ===============================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
API_BASE_URL=http://localhost:3001/api

# Production URLs
# FRONTEND_URL=https://app.etelios.com
# BACKEND_URL=https://api.etelios.com
# API_BASE_URL=https://api.etelios.com/api

# ===============================
# Monitoring & Logging
# ===============================
SENTRY_DSN=your_sentry_dsn_for_error_tracking
LOG_FILE_PATH=logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=7

# ===============================
# Feature Flags
# ===============================
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_GEOFENCING=true
ENABLE_FACIAL_RECOGNITION=false
ENABLE_TWO_FACTOR_AUTH=false

# ===============================
# Microservices URLs (Kubernetes/Docker)
# ===============================
AUTH_SERVICE_URL=http://auth-service:3001
HR_SERVICE_URL=http://hr-service:3002
ATTENDANCE_SERVICE_URL=http://attendance-service:3003
PAYROLL_SERVICE_URL=http://payroll-service:3004
NOTIFICATION_SERVICE_URL=http://notification-service:3005
ANALYTICS_SERVICE_URL=http://analytics-service:3006
DOCUMENT_SERVICE_URL=http://document-service:3007
CRM_SERVICE_URL=http://crm-service:3008
CPP_SERVICE_URL=http://cpp-service:3009
TENANT_REGISTRY_SERVICE_URL=http://tenant-registry-service:3010
PRESCRIPTION_SERVICE_URL=http://prescription-service:3011
PURCHASE_SERVICE_URL=http://purchase-service:3012
SALES_SERVICE_URL=http://sales-service:3013
INVENTORY_SERVICE_URL=http://inventory-service:3014
FINANCIAL_SERVICE_URL=http://financial-service:3015
SERVICE_MANAGEMENT_URL=http://service-management:3016
REALTIME_SERVICE_URL=http://realtime-service:3017
MONITORING_SERVICE_URL=http://monitoring-service:3018

# ===============================
# Kubernetes Namespace
# ===============================
NAMESPACE=etelios-backend-prod
K8S_ENV=true

# ===============================
# Development Settings
# ===============================
DEBUG=false
MOCK_DATA=false
SEED_DATABASE=false
ENABLE_SWAGGER=false
