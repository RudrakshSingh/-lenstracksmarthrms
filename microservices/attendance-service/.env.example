# attendance-service Environment Configuration
NODE_ENV=development
PORT=3003
SERVICE_NAME=attendance-service

# Database
MONGO_URI=mongodb://localhost:27017/etelios_attendance_service

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-jwt-secret-key
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key

# External Services
AUTH_SERVICE_URL=http://auth-service:3001
NOTIFICATION_SERVICE_URL=http://notification-service:3015
HR_SERVICE_URL=http://hr-service:3002
# When attendance has no roster shift on record: max session length & minimum present hours fallback (default 10)
DEFAULT_SHIFT_HOURS_WHEN_NO_ROSTER=10
HR_LOOKUP_REQUEST_TIMEOUT_MS=2500
HR_LOOKUP_TOTAL_TIMEOUT_MS=8000
ENABLE_CROSS_TENANT_LOOKUP=false
ENABLE_ANY_EMPLOYEE_FALLBACK=false

# Clock-in/out without GPS for NO_GEOFENCE / ROAMING / BACKOFFICE or roles listed below (comma-separated, e.g. MANAGER).
# When relaxed and lat/lng omitted, defaults below are stored (set to your HQ coords if reports need a real point).
ATTENDANCE_OPTIONAL_GPS_ROLES=MANAGER
NO_GEOFENCE_DEFAULT_LAT=0
NO_GEOFENCE_DEFAULT_LNG=0

# Roster: when enforcement is active (see start date), employees without a today roster row get 403 on clock-in.
# Set to false if daily rosters are not yet populated for all staff (they still clock in against assigned store + geofence).
ROSTER_ENFORCEMENT_ENABLED=true
# ISO calendar date (UTC midnight) when enforcement turns on if ENABLED is not false (default 2026-04-02)
ROSTER_ENFORCEMENT_START_DATE=2026-04-02
# Business calendar for "today" when resolving roster (default Asia/Kolkata)
ATTENDANCE_BUSINESS_TZ=Asia/Kolkata

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@etelios.com

# SMS
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# File Storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Security
ENCRYPTION_MASTER_KEY=your-32-character-encryption-key
CORS_ORIGIN=http://localhost:3000
