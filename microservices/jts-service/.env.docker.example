# Copy: cp .env.docker.example .env
# Phir: docker compose -f docker-compose.standalone.yml up -d --build

JWT_SECRET=change-me-same-as-auth-if-you-use-jwt-from-auth

# Optional — bahar ka Mongo/Redis use karna ho to mongo/redis services band karo
# aur ye URLs set karo:
# MONGO_URI=mongodb://user:pass@host:27017/etelios_jts
# REDIS_URL=redis://host:6379

JTS_PORT=3018

# Nginx / ALB agar /jts prefix pe forward karta hai:
# JTS_PUBLIC_PATH_PREFIX=/jts

# CORS
# CORS_ORIGIN=https://app.tumharadomain.com

# Bahar ke microservices (optional)
# ATTENDANCE_SERVICE_URL=http://attendance:3003
# REALTIME_SERVICE_URL=http://realtime:3017

# npm run contract-verify-authed — live API (optional)
# JTS_CONTRACT_BASE_URL=https://api.etelios.com
# JTS_AUTH_EMAIL=
# JTS_AUTH_PASSWORD=
# JTS_INTERNAL_SERVICE_TOKEN=
# JTS_INTERNAL_TENANT_ID=

# SLA: notify tenant admins (TENANT_ADMIN, SUPERADMIN, ADMIN, HOD) on every breach, all teams.
# SLA_NOTIFY_ADMINS=false
# Optional: also notify admins on “due soon” warnings (noisy); default off.
# SLA_NOTIFY_ADMINS_ON_WARNING=true

# Outbound integration: queues `jts.sla.breached` (WebhookLog) when URL is set — either globally or per tenant (Tenant.settings.integrations.sla_breach_webhook_url).
# JTS_SLA_BREACH_WEBHOOK_URL=https://hooks.example.com/jts-sla
# Optional: disable webhooks even if URL is set (default: enabled when URL present).
# JTS_SLA_WEBHOOKS_ENABLED=false

# Hourly digest to admins when any breach logs were created in the past hour.
# SLA_ADMIN_DIGEST_ENABLED=false
